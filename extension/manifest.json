{
  "manifest_version": 3,
  "name": "Nepal Fin Buddy",
  "version": "0.2.0",
  "description": "Companion for Nepal Fin Buddy: prefills the IRD prize portal today, with room for more helpers and alerts.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://prize.ird.gov.np/*"
      ],
      "js": [
        "src/core.js",
        "src/features/ird-prize-prefill.js",
        "src/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
